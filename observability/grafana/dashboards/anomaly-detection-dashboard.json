{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🔍 Latency & Statistical Anomalies",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "smooth" },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "title": "Latency Spike Anomaly (Moving Avg vs p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "Current p95 Latency",
          "refId": "A"
        },
        {
          "expr": "avg_over_time((histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le)) * 1000)[5m:30s])",
          "legendFormat": "5m Baseline Average",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "title": "Traffic Surge / Sudden Drop (RPS Derivative)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "deriv(sum(rate(http_server_requests_seconds_count[1m]))[1m:10s])",
          "legendFormat": "RPS Acceleration (Δ / dt)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 200,
      "title": "Memory Drift & Invariant Anomalies",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 25 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "title": "JVM Heap Slope (Memory Leak Detector)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "Heap Memory Used",
          "refId": "A"
        },
        {
          "expr": "predict_linear(sum(jvm_memory_used_bytes{area=\"heap\"})[10m], 3600)",
          "legendFormat": "1h Linear Projected Memory",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "title": "Idempotency Replay Ratio Anomaly",
      "type": "gauge",
      "targets": [
        {
          "expr": "(sum(rate(http_server_requests_seconds_count{status=\"200\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count[1m])), 0.001)) * 100",
          "legendFormat": "Replay Traffic %",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["anomaly", "drift", "memory-leak", "security"],
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "Payment Ledger Engine — Anomaly & Drift Detection",
  "uid": "ledger-anomaly-detection"
}

