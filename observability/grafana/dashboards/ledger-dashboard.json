              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 10 },
      "id": 5,
      "title": "Active Worker Threads",
      "type": "stat",
      "targets": [
        {
          "expr": "tomcat_threads_current_threads",
          "legendFormat": "Threads",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
