          "expr": "(sum(rate(http_server_requests_seconds_count{status=~\"2..\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count[1m])), 0.001)) * 100",
          "legendFormat": "Success Rate",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": {
